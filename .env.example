# ==============================================================================
# IDEACUBATOR PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# ── 1. PUBLIC FRONTEND BROWSER CONFIGURATION (Safe to expose) ──
# The Firebase client configuration is public and safe to run in static GitHub Pages.
# It is configured in assets/js/config.js as window.IC_CONFIG.
#
# NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDHPuZ7fAXInpVSPF5Ki7qJwBYfRUlJ2A4"
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="rational-world-330006.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="rational-world-330006"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="rational-world-330006.firebasestorage.app"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="115200442212"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:115200442212:web:b2cd9d4d48738da9ed4471"

# ── 2. PRIVATE SERVER SECRETS (NEVER EXPOSE IN BROWSER / GITHUB PAGES) ──
# These secrets are strictly used by Firebase Cloud Functions.
# Set them using the Firebase CLI Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
#
GEMINI_API_KEY="AIzaSy...YOUR_SECURE_GEMINI_API_KEY"

# Optional: Dedicated Email Delivery (e.g. Resend / SendGrid)
# RESEND_API_KEY="re_..."
# ADMIN_EMAIL="admin@ideacubator.in"
